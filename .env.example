# -----------------------------------------------------------------------------
# Enterprise Knowledge Copilot environment template
# Copy to .env for local Docker, or provide these variables through your
# deployment platform / secret manager in production.
# NEVER commit a real .env file or credentials.
# -----------------------------------------------------------------------------

ENVIRONMENT=development

# Docker Compose PostgreSQL connection. For host-native development use
# localhost instead of postgres.
DATABASE_URL=postgresql+psycopg://copilot:replace-with-db-password@postgres:5432/copilot
POSTGRES_DB=copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Current AI implementation uses Gemini directly. EMBEDDING_API_KEY is the
# Gemini API key used by both the embedding and LLM services.
EMBEDDING_API_KEY=replace-with-your-gemini-api-key
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
EMBEDDING_DIMENSION=1536

# Retained for compatibility with the existing configurable service contract.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.25
MAX_UPLOAD_SIZE_MB=10

# Local example. Production must contain only the real frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Persist this path using the Docker uploads volume or external/object storage.
UPLOAD_DIR=/app/storage/uploads
LOG_LEVEL=INFO

# Disable API documentation in production unless you explicitly need it.
ENABLE_DOCS=true
ENABLE_REDOC=true
WEB_CONCURRENCY=2

# Frontend build-time public URL. For production this must be your HTTPS API URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
